{
  "id": "internet-entry-ad",
  "goal": "Close the ad that covers the page",
  "start_url": "https://the-internet.herokuapp.com/entry_ad",
  "credentials": {
    "public": true
  },
  "random_seed": 1,
  "time_origin": 1790000000000,
  "steps_min": 1,
  "steps": [
    {
      "tool": "click",
      "args": {
        "target": "text:Close"
      }
    }
  ],
  "success": [
    {
      "eval": "getComputedStyle(document.getElementById('modal')).display",
      "equals": "none"
    }
  ]
}

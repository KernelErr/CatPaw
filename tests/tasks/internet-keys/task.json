{
  "id": "internet-keys",
  "goal": "Press a key in the key presses field, read what the page says it got, and look at what happened in the tab",
  "start_url": "https://the-internet.herokuapp.com/key_presses",
  "random_seed": 1,
  "time_origin": 1790000000000,
  "steps_min": 3,
  "steps": [
    {
      "tool": "press",
      "args": {
        "key": "Tab",
        "target": "css:#target"
      }
    },
    {
      "tool": "press",
      "args": {
        "key": "Shift+Tab"
      }
    },
    {
      "tool": "logs",
      "args": {
        "kind": "events"
      }
    }
  ],
  "success": [
    {
      "text_contains": "You entered: TAB"
    }
  ]
}

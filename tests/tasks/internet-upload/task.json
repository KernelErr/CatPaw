{
  "id": "internet-upload",
  "goal": "Upload a text file; choosing a local file needs the user's approval, and so does sending the form",
  "start_url": "https://the-internet.herokuapp.com/upload",
  "credentials": {
    "public": true
  },
  "random_seed": 1,
  "time_origin": 1790000000000,
  "steps_min": 4,
  "steps": [
    {
      "tool": "act",
      "args": {
        "kind": "upload",
        "target": "css:#file-upload",
        "files": [
          "hello.txt"
        ]
      }
    },
    {
      "approve": "c1"
    },
    {
      "tool": "act",
      "args": {
        "kind": "upload",
        "target": "css:#file-upload",
        "files": [
          "hello.txt"
        ],
        "confirmation": "c1"
      }
    },
    {
      "tool": "click",
      "args": {
        "target": "button \"Upload\""
      }
    },
    {
      "approve": "c2"
    },
    {
      "tool": "click",
      "args": {
        "target": "button \"Upload\"",
        "confirmation": "c2"
      }
    }
  ],
  "success": [
    {
      "text_contains": "File Uploaded!"
    },
    {
      "text_contains": "hello.txt"
    }
  ]
}

// CatPaw additions to the vendored Web IDL corpus: members defined by
// specifications that are not vendored as a whole.

// https://w3c.github.io/webdriver/#interface
interface mixin NavigatorAutomationInformation {
  readonly attribute boolean webdriver;
};
Navigator includes NavigatorAutomationInformation;

// https://drafts.csswg.org/cssom/#cssomstring-type
typedef USVString CSSOMString;

// CSSOM defines one attribute on CSSStyleProperties per supported CSS
// property (`style.color`, `style.backgroundColor`,
// `style["background-color"]`), in prose rather than IDL. They are modelled
// as named properties; the extended attribute tells the bindings that, like
// real attributes, they never shadow members found on the prototype chain.
[CatPawNamedPropertiesAreAttributes]
partial interface CSSStyleProperties {
  getter CSSOMString (CSSOMString property);
  setter undefined (CSSOMString property, [LegacyNullToEmptyString] CSSOMString value);
};

// Attributes are not nodes of the tree, and are not kept as nodes here:
// an `Attr` is a view of one attribute of an element. The members script
// asks of an attribute as a node are declared on `Attr` itself; the other
// members of `Node` do not apply to it.
[CatPawObject]
partial interface Attr {
  readonly attribute unsigned short nodeType;
  readonly attribute DOMString nodeName;
  attribute DOMString? nodeValue;
  attribute DOMString? textContent;
  readonly attribute Document? ownerDocument;
  readonly attribute Node? parentNode;
  readonly attribute Element? parentElement;
};

// https://w3c.github.io/webcrypto/#crypto-interface, without SubtleCrypto.
// (The specification's IDL as a whole uses syntax the parser here does not
// read yet, so it is not vendored.)
partial interface mixin WindowOrWorkerGlobalScope {
  [SameObject] readonly attribute Crypto crypto;
};

[Exposed=(Window,Worker)]
interface Crypto {
  [SameObject] readonly attribute SubtleCrypto subtle;
  ArrayBufferView getRandomValues(ArrayBufferView array);
  DOMString randomUUID();
};

// https://w3c.github.io/webcrypto/#subtlecrypto-interface: digest() alone,
// whose algorithm (`AlgorithmIdentifier`, a name or an object with a
// `name`) is taken as `any` and read by the implementation. The key-based
// methods are absent until there is key handling.
[Exposed=(Window,Worker)]
interface SubtleCrypto {
  Promise<any> digest(any algorithm, BufferSource data);
};

// A window of another frame (an iframe's `contentWindow`, a frame's
// `parent` or `top`, a message's `source`). Frames run as separate pages,
// so another frame's window offers what a cross-origin window does:
// messages, the frame tree, focus, and no document.
[Exposed=Window]
interface CatPawRemoteWindow {
  undefined postMessage(any message, USVString targetOrigin, optional sequence<object> transfer = []);
  undefined postMessage(any message, optional WindowPostMessageOptions options = {});
  readonly attribute boolean closed;
  readonly attribute WindowProxy? parent;
  readonly attribute WindowProxy? top;
  readonly attribute WindowProxy self;
  readonly attribute WindowProxy window;
  readonly attribute WindowProxy frames;
  readonly attribute unsigned long length;
  undefined focus();
  undefined blur();
  undefined close();
};
